{
  "manifest_version": "0.4",
  "name": "borsdata-mcp",
  "display_name": "Börsdata MCP",
  "description": "MCP-server för Börsdata API — ger tillgång till nordisk aktiedata, finansiella rapporter, nyckeltal och metadata.",
  "long_description": "Denna MCP-server hämtar data från Börsdata via deras REST API (apiservice.borsdata.se). Servern läser eller skriver inga filer på din dator och kör inga kommandon — den gör enbart utgående HTTPS-anrop till Börsdatas API med din API-nyckel.",
  "version": "%%VERSION%%",
  "author": {
    "name": "Emmanuel Ay",
    "url": "https://github.com/emmanuelay"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/emmanuelay/borsdata-mcp"
  },
  "homepage": "https://github.com/emmanuelay/borsdata-mcp",
  "license": "MIT",
  "server": {
    "type": "binary",
    "entry_point": "borsdata-mcp",
    "mcp_config": {
      "command": "${__dirname}/borsdata-mcp",
      "env": {
        "BORSDATA_API_KEY": "${user_config.api_key}"
      },
      "platform_overrides": {
        "win32": {
          "command": "${__dirname}/borsdata-mcp.exe"
        }
      }
    }
  },
  "compatibility": {
    "platforms": ["darwin", "win32", "linux"]
  },
  "user_config": {
    "api_key": {
      "type": "string",
      "title": "Börsdata API-nyckel",
      "description": "Din Börsdata API-nyckel. Skaffa en på https://borsdata.se",
      "required": true,
      "sensitive": true
    }
  },
  "tools": [
    {
      "name": "list_instruments",
      "description": "Lista alla instrument (bolag) i Börsdata. Returnerar ID, namn, ticker, sektor, marknad, bransch och land."
    },
    {
      "name": "search_instruments",
      "description": "Sök instrument efter namn eller ticker. Skiftlägesokänslig sökning."
    },
    {
      "name": "get_instruments_updated",
      "description": "Hämta tidsstämplar för senaste uppdatering av varje instrument."
    },
    {
      "name": "get_stock_splits",
      "description": "Hämta alla aktiesplittar. Returnerar instrument-ID, datum, splittyp och förhållande."
    },
    {
      "name": "get_stock_prices",
      "description": "Hämta historiska aktiekurser för ett specifikt instrument. Returnerar datum, öppning, högsta, lägsta, stängning och volym."
    },
    {
      "name": "get_latest_stock_prices",
      "description": "Hämta senaste aktiekurser för alla instrument."
    },
    {
      "name": "get_stock_prices_by_date",
      "description": "Hämta aktiekurser för alla instrument på ett specifikt datum."
    },
    {
      "name": "get_reports",
      "description": "Hämta finansiella rapporter för ett instrument. Stöder årsrapporter, R12 (rullande 12 månader) och kvartalsrapporter."
    },
    {
      "name": "get_kpis_updated",
      "description": "Hämta tidsstämplar för senaste nyckeltalsberäkningar per instrument."
    },
    {
      "name": "get_kpi_history",
      "description": "Hämta nyckeltalshistorik för ett instrument. Stöder olika rapporttyper och pristyper."
    },
    {
      "name": "get_kpi_screener",
      "description": "Hämta ett enskilt nyckeltalsvärde för ett specifikt instrument, period och beräkningstyp."
    },
    {
      "name": "get_kpi_list_screener",
      "description": "Hämta ett nyckeltal för alla instrument. Användbart för att screena och filtrera aktier."
    },
    {
      "name": "get_kpi_summary",
      "description": "Hämta nyckeltalssammanfattning för ett instrument. Returnerar aggregerade nyckeltal per år."
    },
    {
      "name": "get_metadata",
      "description": "Hämta referensdata och metadata. Används för att slå upp namn på ID:n som returneras av andra verktyg."
    },
    {
      "name": "get_insider_holdings",
      "description": "Hämta insidertransaktioner för angivna instrument. Returnerar ägare, position, antal aktier, pris, belopp och transaktionstyp. Stöder filtrering på köp/sälj, minimibelopp och datumintervall."
    },
    {
      "name": "get_short_holdings",
      "description": "Hämta blankningstdata för alla instrument. Returnerar blankningsandel, antal innehavare, blankat värde (MSEK) och trenddata."
    },
    {
      "name": "get_buyback_holdings",
      "description": "Hämta aktieåterköp för angivna instrument. Returnerar förändring, pris, valuta, antal aktier och datum."
    },
    {
      "name": "get_report_calendar",
      "description": "Hämta rapportdatum för angivna instrument. Returnerar publiceringsdatum och rapporttyp."
    },
    {
      "name": "get_dividend_calendar",
      "description": "Hämta utdelningsdatum för angivna instrument. Returnerar utdelningsbelopp, valuta, frekvens, x-dag och utdelningstyp."
    }
  ],
  "prompts": [
    {
      "name": "analysera_aktie",
      "description": "Analysera en aktie med hjälp av Börsdata",
      "arguments": ["ticker"],
      "text": "Sök efter aktien med ticker ${arguments.ticker}, hämta sedan senaste aktiekursen, de senaste kvartalsrapporterna och en nyckeltalssammanfattning. Ge en kortfattad finansiell översikt."
    },
    {
      "name": "jamfor_aktier",
      "description": "Jämför två aktier sida vid sida",
      "arguments": ["ticker1", "ticker2"],
      "text": "Sök efter aktierna ${arguments.ticker1} och ${arguments.ticker2}. Hämta senaste aktiekurser, kvartalsrapporter och nyckeltalssammanfattning för båda. Jämför dem sida vid sida och lyft fram viktiga skillnader."
    },
    {
      "name": "insiderhandel",
      "description": "Visa senaste insidertransaktioner för en aktie",
      "arguments": ["ticker"],
      "text": "Sök efter aktien ${arguments.ticker} och hämta sedan de senaste insidertransaktionerna. Sammanfatta vilka insiders som köpt och sålt, samt belopp och datum."
    },
    {
      "name": "kommande_rapporter",
      "description": "Visa kommande rapportdatum för aktier",
      "arguments": ["tickers"],
      "text": "Sök efter aktierna ${arguments.tickers} (kommaseparerade tickers) och hämta rapportkalendern för var och en. Lista kommande rapportdatum i kronologisk ordning."
    }
  ]
}
